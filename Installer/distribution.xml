<?xml version="1.0" encoding="utf-8"?>
<!-- __VERSION__, __BUNDLE_ID__ and __ORGANIZATION__ are substituted by Scripts/make-installer.sh -->
<installer-gui-script minSpecVersion="2">
    <title>Ember __VERSION__</title>
    <organization>__ORGANIZATION__</organization>
    <options customize="never" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_localSystem="true" enable_anywhere="false" enable_currentUserHome="false"/>
    <volume-check>
        <allowed-os-versions>
            <os-version min="14.0"/>
        </allowed-os-versions>
    </volume-check>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <choices-outline>
        <line choice="default">
            <line choice="__BUNDLE_ID__"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="__BUNDLE_ID__" visible="false">
        <pkg-ref id="__BUNDLE_ID__"/>
    </choice>
    <pkg-ref id="__BUNDLE_ID__" version="__VERSION__" onConclusion="none">Ember-component.pkg</pkg-ref>
</installer-gui-script>
