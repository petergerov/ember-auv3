# Copy to .env and fill in. Read by Scripts/generate-project.sh (project.yml) and
# Scripts/make-installer.sh; .env is gitignored.

# Apple Developer team ID (10 characters, shown in your Apple Developer account).
# Used for iOS device signing and the macOS installer; may be left empty for local macOS builds.
TEAM_ID=XXXXXXXXXX

# Installer only: name on your Developer ID certificates, i.e. "Developer ID Application: <name> (<team>)".
DEVELOPER_NAME="Your Name"

# App bundle identifier (the extension gets <BUNDLE_ID>.audiounit) and installer package identifier.
BUNDLE_ID=com.example.ember

# Optional: full signing identities, if they don't follow the pattern above.
# APP_IDENTITY="Developer ID Application: Your Name (XXXXXXXXXX)"
# PKG_IDENTITY="Developer ID Installer: Your Name (XXXXXXXXXX)"

# Optional: notarytool keychain profile. When set, the installer is notarized and stapled.
# NOTARY_PROFILE=ember-notary
